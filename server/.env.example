# ================================================================
# SGAS — Variables de entorno del servidor
# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas el archivo .env a git.
# ================================================================

# URL de conexión a PostgreSQL (Supabase)
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://usuario:password@db.supabase.co:5432/postgres

# API Key para autenticar requests del frontend
# Debe coincidir con el valor en js/storage.js (const API_KEY)
# Usá un valor largo y aleatorio en producción
API_KEY=cambia-esto-por-algo-aleatorio-y-largo

# Puerto del servidor (Render lo setea automáticamente)
# PORT=3000
